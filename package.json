{
  "name": "designcritique",
  "version": "0.7.1",
  "description": "Mobile design critique for mockups and prototypes, as a Claude Code plugin",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "capture": "node scripts/capture/capture.mjs",
    "checks": "node scripts/checks/run-checks.mjs",
    "report": "node scripts/report/render-report.mjs",
    "eval": "node scripts/eval/run-evals.mjs",
    "eval:score": "node scripts/eval/score.mjs",
    "test": "node --test tests/*.test.mjs",
    "gate": "node scripts/report/gate.mjs",
    "decide": "node scripts/report/decide.mjs",
    "eval:review": "node scripts/eval/run-review-evals.mjs",
    "crawl": "node scripts/crawl/crawl.mjs",
    "eval:noise": "node scripts/eval/noise.mjs",
    "eval:source": "node scripts/eval/run-source-evals.mjs",
    "eval:tokens": "node scripts/eval/run-token-evals.mjs",
    "eval:lenses": "node scripts/eval/score-lenses.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "adm-zip": "^0.5.18",
    "ajv": "^8.20.0",
    "impeccable": "4.9.2",
    "playwright": "^1.50.0",
    "transitions-agent": "0.11.2",
    "unslopovich": "3.0.0",
    "yaml": "^2.6.0"
  }
}
