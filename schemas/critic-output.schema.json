{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/munderhaug/designcritique/schemas/critic-output.schema.json",
  "title": "designcritique critic output",
  "type": "object",
  "required": ["critic", "findings"],
  "properties": {
    "critic": { "enum": ["ux", "ui", "impeccable"] },
    "frame_check": {
      "type": "object",
      "properties": {
        "fit": { "enum": ["strong", "partial", "weak", "unknown"] },
        "summary": { "type": "string" },
        "assumptions_relied_on": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "verdict"],
        "properties": {
          "task": { "type": "string" },
          "user": { "type": "string" },
          "verdict": { "enum": ["supported", "at-risk", "blocked", "not-covered"] },
          "summary": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "screen": { "type": "string" },
                "action": { "type": "string" },
                "q1": { "type": "boolean" }, "q2": { "type": "boolean" },
                "q3": { "type": "boolean" }, "q4": { "type": "boolean" },
                "finding_ids": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "screen", "rule", "severity", "title", "evidence", "recommendation"],
        "properties": {
          "id": { "type": "string" },
          "screen": { "type": "string" },
          "rule": { "type": "string" },
          "basis": { "type": "array", "items": { "type": "string" } },
          "category": { "enum": ["task-fit", "ux", "content", "visual", "layout", "typography", "color", "a11y", "platform", "tokens"] },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "task": { "type": ["string", "null"] },
          "element": {
            "type": ["object", "null"],
            "properties": {
              "selector": { "type": ["string", "null"] },
              "region": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "screen": { "type": "string" },
          "text": { "type": "string" },
          "basis": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "recommended"],
        "properties": {
          "group": { "type": "string" },
          "recommended": { "type": "string" },
          "ranking": { "type": "array", "items": { "type": "string" } },
          "reasons": { "type": "string" }
        }
      }
    }
  }
}
