{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/munderhaug/designcritique/schemas/critic-output.schema.json",
  "title": "designcritique critic output",
  "type": "object",
  "required": [
    "critic",
    "findings"
  ],
  "properties": {
    "critic": {
      "type": "string",
      "description": "anthropic-design, impeccable, or external-<name> for an extra judge (see critic-brief.md)",
      "pattern": "^(anthropic-design|impeccable|external-[a-z0-9-]+)$"
    },
    "frame_check": {
      "type": "object",
      "properties": {
        "fit": {
          "enum": [
            "strong",
            "partial",
            "weak",
            "unknown"
          ]
        },
        "summary": {
          "type": "string"
        },
        "assumptions_relied_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Overall 0-10, per the anchors in output-format.md"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "verdict"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "supported",
              "at-risk",
              "blocked",
              "not-covered"
            ]
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "screen": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "q1": {
                  "type": "boolean"
                },
                "q2": {
                  "type": "boolean"
                },
                "q3": {
                  "type": "boolean"
                },
                "q4": {
                  "type": "boolean"
                },
                "finding_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "0-10 for this key task, per the anchors in output-format.md"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "screen",
          "rule",
          "severity",
          "title",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "screen": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "enum": [
              "task-fit",
              "ux",
              "content",
              "visual",
              "layout",
              "typography",
              "color",
              "a11y",
              "platform",
              "tokens"
            ]
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "element": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "screen": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "recommended"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "recommended": {
            "type": "string"
          },
          "ranking": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasons": {
            "type": "string"
          }
        }
      }
    },
    "method": {
      "type": "string"
    },
    "taste_check": {
      "type": "object",
      "description": "How close the screens are to the references the person chose (manifest taste). Judged apart from usability findings.",
      "required": [
        "score",
        "summary"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "summary": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "screen",
              "text"
            ],
            "properties": {
              "screen": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
