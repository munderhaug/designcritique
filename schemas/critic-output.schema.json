{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/munderhaug/designcritique/schemas/critic-output.schema.json",
  "title": "designcritique critic output",
  "type": "object",
  "required": [
    "critic",
    "findings"
  ],
  "properties": {
    "critic": {
      "type": "string",
      "description": "anthropic-design, impeccable, the review lenses ia, scope and system, or external-<name> for an extra judge",
      "pattern": "^(anthropic-design|impeccable|ia|scope|system|external-[a-z0-9-]+)$"
    },
    "frame_check": {
      "type": "object",
      "properties": {
        "fit": {
          "enum": [
            "strong",
            "partial",
            "weak",
            "unknown"
          ]
        },
        "summary": {
          "type": "string"
        },
        "assumptions_relied_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Overall 0-10, per the anchors in output-format.md"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "verdict"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "supported",
              "at-risk",
              "blocked",
              "not-covered"
            ]
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "screen": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "q1": {
                  "type": "boolean"
                },
                "q2": {
                  "type": "boolean"
                },
                "q3": {
                  "type": "boolean"
                },
                "q4": {
                  "type": "boolean"
                },
                "finding_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10,
            "description": "0-10 for this key task, per the anchors in output-format.md; null (or left out) when the verdict is not-covered"
          },
          "subscores": {
            "type": "object",
            "description": "Independent 0-10 assessments made before the task score (ISO 9241-11; mediating assessments, Kahneman, Sibony & Sunstein, Noise, 2021).",
            "properties": {
              "effectiveness": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "efficiency": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "satisfaction": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            }
          },
          "id": {
            "type": "string",
            "pattern": "^T[0-9]+$",
            "description": "Key task ID from PRODUCT.md: the list number (T1, T2, \u2026)"
          },
          "coverage": {
            "enum": [
              "whole",
              "partial"
            ],
            "description": "whole: the critic saw every screen of the task; partial: only some (a batch reviewer). Only whole-task scores count in the gate."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "screen",
          "rule",
          "severity",
          "title",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "screen": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "enum": [
              "a11y",
              "color",
              "consistency",
              "content",
              "ethics",
              "ia",
              "journey",
              "layout",
              "logic",
              "platform",
              "scope",
              "spec",
              "states",
              "task-fit",
              "tokens",
              "typography",
              "ux",
              "visual"
            ]
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "element": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "level": {
            "enum": [
              "screen",
              "journey",
              "system"
            ],
            "description": "Where the problem lives: one screen, a journey across screens, or the whole product."
          },
          "affected_screens": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Screen ids (from the manifest) the problem spans; for journey and system findings."
          },
          "journey": {
            "type": "string",
            "description": "Journey id, for journey findings."
          },
          "move_to": {
            "description": "For placement findings: where the thing should go.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "to"
                ],
                "properties": {
                  "item": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "screen": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "recommended"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "recommended": {
            "type": "string"
          },
          "ranking": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasons": {
            "type": "string"
          }
        }
      }
    },
    "method": {
      "type": "string"
    },
    "journeys": {
      "type": "array",
      "description": "Journey verdicts (review mode).",
      "items": {
        "type": "object",
        "required": [
          "journey",
          "verdict"
        ],
        "properties": {
          "journey": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "supported",
              "at-risk",
              "blocked",
              "not-covered"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "integer"
                },
                "screen": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "verdict": {
                  "enum": [
                    "ok",
                    "friction",
                    "blocked"
                  ]
                },
                "note": {
                  "type": "string"
                },
                "finding_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "moves": {
      "type": "array",
      "description": "Proposed structural moves (review mode). Proposals only: never applied automatically.",
      "items": {
        "type": "object",
        "required": [
          "item",
          "to",
          "reason"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "finding_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "impact": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "One word: high, medium or low. The reason goes in reason."
          }
        }
      }
    },
    "scope": {
      "type": "array",
      "description": "Feature against problem (review mode).",
      "items": {
        "type": "object",
        "required": [
          "feature",
          "verdict"
        ],
        "properties": {
          "feature": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "keep",
              "cut",
              "add",
              "move",
              "defer",
              "rethink"
            ]
          },
          "job": {
            "type": [
              "string",
              "null"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "finding_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
